# ═══════════════════════════════════════════════════════════════
# Git Ignore — Hospital Data Warehouse
# ═══════════════════════════════════════════════════════════════

# ── Dependencies ────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ────────────────────────────────────────
.venv/
venv/
env/
ENV/
ENV.bak/
venv.bak/

# ── Environment & secrets ───────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
secrets/
*.secret

# ── Docker ──────────────────────────────────────────────────────
Dockerfile.dev
docker-compose.override.yml
docker-compose.*.yml
!.dockerignore

# ── IDE / Editor ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db
*.tmp

# ── Build artifacts ─────────────────────────────────────────────
frontend/dist/
frontend/dist-static/
*.log
*.log.*
coverage/
.coverage
htmlcov/
.tox/
.nox/
.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Vite / React ────────────────────────────────────────────────
node_modules/.cache/
vite.config.js.map
*.tsbuildinfo

# ── Local databases & data dumps ────────────────────────────────
*.sql
!sql/schema.sql
*.dump
*.bak
*.db
*.sqlite
*.sqlite3
postgres_data/
pg_data/
data/exports/
data/tmp/

# ── OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db