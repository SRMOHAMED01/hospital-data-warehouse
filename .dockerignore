node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
dist/
vite.config.js.map
*.tsbuildinfo

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

